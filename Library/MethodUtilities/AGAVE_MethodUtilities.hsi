// {{{ 5 "DateTimeStamp" "Begin"
function DateTimeStamp( variable & calc_o_s_concatDateTime ) void {
// }} ""
private variable retTime;
private variable retDate;
private variable str_traceDateTime;
// {{ 5 "DateTimeStamp" "InitLocals"
calc_o_s_concatDateTime = 0;
// }} ""
// {{{ 9 1 0 "79b8c7b1_14ec_4ac1_aad0785008945c61" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
retTime = TimGetFormattedTime(Translate(""));
// }} ""
// {{{ 10 1 0 "64939672_5661_47a6_8b5f4e10e79a69aa" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
StrReplace(retTime, Translate(":"), Translate(""));
// }} ""
// {{{ 11 1 0 "d3d7f206_9194_404b_b1c1473b76ba48d6" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
retDate = TimGetFormattedDate(Translate("%Y%m%d"));
// }} ""
// {{{ 12 1 0 "079e315b_c4f3_418d_838a93ac14ee1ab3" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
calc_o_s_concatDateTime = StrConcat4(retDate, Translate(""), retTime, Translate(""));
// }} ""
// {{{ 13 1 0 "b8584547_c2cb_4847_9b13c8d34a8bbd91" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
str_traceDateTime = StrConcat2(Translate("DateTime of run: "), calc_o_s_concatDateTime);
// }} ""
// {{{ 14 1 0 "f5fe1b22_3834_422d_9eacdd31274a5713" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
_StandardLibraryTrace(str_traceDateTime);
// }} ""
// {{{ 5 "DateTimeStamp" "End"
}
// }} ""
